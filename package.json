{
  "name": "rn-predictive-back",
  "version": "0.0.1",
  "private": true,
  "description": "Scratch app for Android predictive back. react-native, react-native-screens and react-navigation are linked from local checkouts by scripts/link.js.",
  "scripts": {
    "postinstall": "node ./scripts/link.js",
    "link": "node ./scripts/link.js",
    "start": "node ./node_modules/react-native/cli.js start",
    "android": "node ./node_modules/react-native/cli.js run-android",
    "gradle-stop": "cd android && ./gradlew --stop"
  },
  "//": [
    "The versions below exist only so that yarn resolves the dependency graph, so",
    "that the React Native CLI discovers these libraries during autolinking.",
    "scripts/link.js (postinstall) then replaces every one of them with a symlink",
    "to the local checkout, which is what actually gets built. Keep the declared",
    "versions close to the checkouts to avoid surprises in the transitive graph."
  ],
  "dependencies": {
    "@react-navigation/core": "8.0.0-alpha.34",
    "@react-navigation/elements": "3.0.0-alpha.48",
    "@react-navigation/native": "8.0.0-alpha.44",
    "@react-navigation/native-stack": "8.0.0-alpha.52",
    "@react-navigation/routers": "8.0.0-alpha.17",
    "escape-string-regexp": "^5.0.0",
    "fast-deep-equal": "^3.1.3",
    "nanoid": "^5.1.11",
    "query-string": "^9.4.0",
    "react": "19.2.3",
    "react-freeze": "^1.0.0",
    "react-is": "^19.2.6",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.27.0",
    "standard-navigation": "^0.0.8",
    "use-latest-callback": "^0.3.5",
    "use-sync-external-store": "^1.6.0",
    "warn-once": "^0.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@types/react": "^19.1.1",
    "typescript": "^5.0.4"
  }
}
